<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" page-range-format="minimal">
  <info>
    <title>Custom Ortho Style (Numeric, Journal Abbrev, Minimal Page Ranges)</title>
    <id>http://www.zotero.org/styles/custom-ortho-style-numeric-abbrev</id>
    <link href="http://www.zotero.org/styles/vancouver" rel="template"/>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <updated>2025-09-16T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <!-- In-text citations as [1], [2-4] -->
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout delimiter=", ">
      <text variable="citation-number" prefix="(" suffix=")"/>
    </layout>
  </citation>

  <!-- Bibliography: n. Authors. Title. Journal Abbrev. Year;Volume(Issue):Pages. -->
  <bibliography et-al-min="7" et-al-use-first="6" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <group delimiter=". ">
        <!-- Authors -->
        <names variable="author">
          <name name-as-sort-order="false" and="text" delimiter=", " initialize-with=". "/>
          <et-al term="et-al"/>
        </names>

        <!-- Title -->
        <text variable="title"/>

        <!-- Journal abbreviation (uses container-title-short if present; otherwise 'short' form) -->
        <text variable="container-title" form="short"/>

        <!-- Year;Volume(Issue):Pages -->
        <group delimiter=";">
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <group delimiter=":">
            <group>
              <text variable="volume"/>
              <group prefix="(" suffix=")">
                <text variable="issue"/>
              </group>
            </group>
            <!-- Minimal page ranges like 180-9 are handled by page-range-format="minimal" -->
            <text variable="page"/>
          </group>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
